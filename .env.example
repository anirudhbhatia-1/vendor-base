# Local company development defaults. Copy to an ignored .env file if needed.
# D-13 also permits a Supabase-hosted synthetic development database; use
# infrastructure/supabase-dev/env.example for that mode.
APP_ENV=local
LOG_LEVEL=debug
API_HOST=127.0.0.1
API_PORT=3001
DATA_MODE=synthetic
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Test-only adapters. Production configuration does not exist yet.
PROVIDER_MODE=fake
OTP_ADAPTER=fake
# Supply a private random value of at least 32 characters in the ignored local .env file.
OTP_HASH_KEY=
SESSION_TOKEN_HASH_KEY=
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_LOCAL_PATH=.local-data/objects
# Supply a separate private random value in the ignored local .env file.
OBJECT_STORAGE_GRANT_KEY=

# Committed company-local defaults. These values are not production credentials.
DATABASE_URL=postgresql://marketplace_local:marketplace_local_only@127.0.0.1:5432/neighbourhood_store_local
TEST_DATABASE_URL=postgresql://marketplace_test:marketplace_test_only@127.0.0.1:5433/neighbourhood_store_test

# Queue connectivity remains unimplemented at Step 2.4.
QUEUE_URL=redis://127.0.0.1:6379
VALKEY_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=neighbourhood-store:local
OTEL_EXPORTER_OTLP_ENDPOINT=
PAYMENT_WEBHOOK_KEY=local-synthetic-payment-webhook-key-material
PROVIDER_CLEARING_ACCOUNT_REFERENCE=SYNTH-ACCOUNT-LOCAL-PROVIDER-CLEARING

# Extra browser origins allowed to call the API, comma separated. The loopback
# PWAs on 3100-3103 are always allowed; a deployed PWA is served from its own
# origin and must be listed here. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=

# Object storage. `filesystem` is local-only and a non-local environment refuses it.
# `supabase` requires both buckets: quarantined evidence never shares a bucket with
# catalogue assets.
OBJECT_STORAGE_CATALOGUE_BUCKET=
OBJECT_STORAGE_EVIDENCE_BUCKET=

# How long worker shutdown waits for an in-flight queue handler. Short by default so a
# watch-mode restart is not held up; a deployment should raise it towards, but under,
# its own container stop grace.
WORKER_SHUTDOWN_GRACE_MS=4000
