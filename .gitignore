# Dependencies and package-manager state
node_modules/
.pnpm-store/

# Build and test output
.next/
out/
.expo/
dist/
build/
coverage/
test-results/
playwright-report/
outputs/
.ci-artifacts/
.online-test-evidence/
*.tsbuildinfo

# Local runtime data
.local-data/
runtime-data/
uploads/

# Environment and credentials
.env
.env.*
!.env.example
infrastructure/online-test/release.env
infrastructure/online-test/secrets/
infrastructure/supabase-production/secrets/
*.pem
*.key
*.p12
*.pfx
# TLS trust material for the managed databases. `*.pem`/`*.key` already covered
# the private halves; the Supabase CA arrives as a .crt and was sitting
# untracked-but-committable, one `git add .` away from entering history.
*.crt
*.cer

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
.gstack/

# Vendored design handoff bundle
design-handoff/
handoff.zip

# Operational spreadsheets and reports kept beside the checkout for convenience.
# Not source, and they routinely carry names, hours and pay.
*.xlsx
*.xlsm

# Continuous Native Generation: the native projects are regenerated by expo prebuild
apps/*/android/
apps/*/ios/

# Local build outputs (APKs from build-android-apk.mjs); never a store artefact
artifacts/

# Local-only scratch and hand-off material
database/scripts/_probe-rt.ts
handoff.zip
manager_daily_work_log_*.xlsx
