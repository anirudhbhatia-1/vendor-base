{
  "name": "@neighbourhood-store/customer-app",
  "version": "0.0.0",
  "private": true,
  "description": "Customer Expo/React Native Android shell for company-local development.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "test:unit": "node --import tsx --test tests/*.spec.ts",
    "android": "node ../../tooling/scripts/ensure-packages-built.mjs && expo start --android --port 8081",
    "build": "expo export --platform android --output-dir dist",
    "dev": "node ../../tooling/scripts/ensure-packages-built.mjs && expo start --offline --port 8081",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neighbourhood-store/app-auth": "workspace:*",
    "@neighbourhood-store/contracts": "workspace:*",
    "@neighbourhood-store/ui-tokens": "workspace:*",
    "expo": "56.0.19",
    "expo-constants": "56.0.25",
    "expo-linking": "56.0.17",
    "expo-router": "56.2.20",
    "expo-secure-store": "56.0.4",
    "expo-splash-screen": "56.0.15",
    "expo-status-bar": "56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
