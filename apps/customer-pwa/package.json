{
  "name": "@neighbourhood-store/customer-pwa",
  "version": "0.0.0",
  "private": true,
  "description": "Customer Next.js PWA shell for company-local development.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:supabase-production": "node ../../tooling/scripts/run-with-public-env.mjs ../../infrastructure/supabase-production/.env next build",
    "dev": "node ../../tooling/scripts/ensure-packages-built.mjs && next dev --hostname 127.0.0.1 --port 3100",
    "dev:supabase": "node ../../tooling/scripts/ensure-packages-built.mjs && node ../../tooling/scripts/run-with-public-env.mjs ../../infrastructure/supabase-dev/.env next dev --hostname 127.0.0.1 --port 3100",
    "dev:supabase-production": "node ../../tooling/scripts/ensure-packages-built.mjs && node ../../tooling/scripts/run-with-public-env.mjs ../../infrastructure/supabase-production/.env next dev --hostname 127.0.0.1 --port 3100",
    "start": "node ../../tooling/scripts/ensure-packages-built.mjs && next start --hostname 127.0.0.1 --port 3100",
    "preview:cloudflare": "opennextjs-cloudflare build && wrangler dev",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:unit": "node ../../tooling/scripts/ensure-packages-built.mjs && tsx --tsconfig tsconfig.test.json --test app/*.spec.ts",
    "typecheck": "next typegen && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neighbourhood-store/contracts": "workspace:*",
    "@neighbourhood-store/i18n": "workspace:*",
    "@neighbourhood-store/ui": "workspace:*",
    "@neighbourhood-store/ui-tokens": "workspace:*",
    "next": "16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "wrangler": "4.128.0"
  }
}
