{
  "name": "@neighbourhood-store/vendor-app",
  "version": "0.0.0",
  "private": true,
  "description": "Neighbourhood Store Vendor Android shell: the vendor PWA hosted in a native WebView with the device states around it.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "test:unit": "node ../../tooling/scripts/ensure-packages-built.mjs && node --import tsx --test tests/*.spec.ts",
    "android": "node ../../tooling/scripts/ensure-packages-built.mjs && expo start --android --port 8082",
    "build": "expo export --platform android --output-dir dist",
    "build:apk": "node ../../tooling/scripts/build-android-apk.mjs",
    "dev": "node ../../tooling/scripts/ensure-packages-built.mjs && expo start --offline --port 8082",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neighbourhood-store/app-shell": "workspace:*",
    "@neighbourhood-store/ui-tokens": "workspace:*",
    "expo": "56.0.19",
    "expo-linking": "56.0.18",
    "expo-location": "56.0.26",
    "expo-network": "56.0.5",
    "expo-status-bar": "56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-webview": "13.16.1"
  }
}
