{
  "name": "@neighbourhood-store/worker",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS/BullMQ worker bootstrap for company-local development.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test:unit": "pnpm --filter @neighbourhood-store/domain-types build && node --import tsx --test src/*.spec.ts",
    "test:integration": "pnpm --filter @neighbourhood-store/domain-types build && pnpm build && node scripts/worker-smoke.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neighbourhood-store/domain-types": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "bullmq": "6.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
