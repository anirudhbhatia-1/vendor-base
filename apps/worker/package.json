{
  "name": "@neighbourhood-store/worker",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS worker bootstrap with PostgreSQL durable jobs for company-local development.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "node ../../tooling/scripts/ensure-packages-built.mjs && node ../../tooling/scripts/run-node-watch.mjs --watch-path src src/main.ts",
    "dev:supabase": "node ../../tooling/scripts/ensure-packages-built.mjs && node ../../tooling/scripts/run-node-watch.mjs --env-file ../../infrastructure/supabase-dev/.env --watch-path src src/main.ts",
    "dev:supabase-production": "node ../../tooling/scripts/ensure-packages-built.mjs && node ../../tooling/scripts/run-node-watch.mjs --env-file ../../infrastructure/supabase-production/.env --watch-path src src/main.ts",
    "start": "node ../../tooling/scripts/ensure-packages-built.mjs && node dist/main.js",
    "test:unit": "node ../../tooling/scripts/ensure-packages-built.mjs && node --import tsx --test src/*.spec.ts",
    "test:integration": "node ../../tooling/scripts/ensure-packages-built.mjs && pnpm build && node scripts/worker-smoke.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neighbourhood-store/database": "workspace:*",
    "@neighbourhood-store/domain-types": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "bullmq": "6.2.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
