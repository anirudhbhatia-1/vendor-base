{
  "name": "@neighbourhood-store/database",
  "version": "0.0.0",
  "private": true,
  "description": "Reviewed PostgreSQL/PostGIS migrations and deterministic company-local fixtures.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "migration:up": "tsx scripts/migrate.ts up --target local",
    "migration:down": "tsx scripts/migrate.ts down --steps 1 --target local",
    "migration:status": "tsx scripts/migrate.ts status --target local",
    "migration:test:up": "tsx scripts/migrate.ts up --target test",
    "migration:supabase-dev:status": "node --env-file=../infrastructure/supabase-dev/.env --import tsx scripts/migrate.ts status --target supabase-dev",
    "migration:supabase-dev:up": "node --env-file=../infrastructure/supabase-dev/.env --import tsx scripts/migrate.ts up --target supabase-dev",
    "migration:supabase-production:status": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/migrate.ts status --target supabase-production",
    "migration:supabase-production:up": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/migrate.ts up --target supabase-production",
    "diagnose:dispatch:supabase-production": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/diagnose-dispatch.ts --target supabase-production",
    "diagnose:dispatch:test": "tsx scripts/diagnose-dispatch.ts --target test",
    "otp:read:supabase-production": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/read-synthetic-otp.ts --target supabase-production",
    "otp:read:local": "tsx scripts/read-synthetic-otp.ts --target local",
    "production:provision-runtime": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/provision-production-runtime.ts",
    "production:verify": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/verify-production.ts",
    "migration:online-test:status": "tsx scripts/migrate.ts status --target online-test",
    "migration:online-test:up": "tsx scripts/migrate.ts up --target online-test",
    "rebuild": "tsx scripts/rebuild.ts --target local",
    "reset": "tsx scripts/reset.ts --target local",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:supabase-admin": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/seed-supabase-admin.ts",
    "acceptance:supabase": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/live-supabase-acceptance.ts",
    "acceptance:fixtures": "node --env-file=../infrastructure/supabase-production/.env --import tsx scripts/live-supabase-fixtures.ts",
    "seed": "tsx scripts/seed.ts --target local",
    "seed:marketplace": "tsx scripts/seed-marketplace.ts",
    "test:unit": "node ../tooling/scripts/ensure-packages-built.mjs && tsx scripts/verify-static.ts && node --import tsx --test src/*.spec.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify:lifecycle": "node ../tooling/scripts/ensure-packages-built.mjs && tsx scripts/verify-lifecycle.ts"
  },
  "dependencies": {
    "@neighbourhood-store/domain-types": "workspace:*",
    "@supabase/supabase-js": "2.58.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
