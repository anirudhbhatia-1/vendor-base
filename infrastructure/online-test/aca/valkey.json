{
  "location": "${ACA_LOCATION}",
  "name": "valkey",
  "type": "Microsoft.App/containerApps",
  "properties": {
    "managedEnvironmentId": "${ACA_ENVIRONMENT_ID}",
    "configuration": {
      "activeRevisionsMode": "Single",
      "ingress": {
        "external": false,
        "transport": "tcp",
        "targetPort": 6379,
        "exposedPort": 6379,
        "allowInsecure": false
      }
    },
    "template": {
      "containers": [
        {
          "name": "valkey",
          "image": "docker.io/valkey/valkey:8.1.4-alpine@sha256:e706d1213aaba6896c162bb6a3a9e1894e1a435f28f8f856d14fab2e10aa098b",
          "command": ["valkey-server"],
          "args": ["--save", "", "--appendonly", "no", "--maxmemory", "96mb"],
          "resources": { "cpu": 0.25, "memory": "0.5Gi" },
          "probes": [
            {
              "type": "Liveness",
              "tcpSocket": { "port": 6379 },
              "periodSeconds": 15,
              "failureThreshold": 3
            }
          ]
        }
      ],
      "scale": { "minReplicas": 1, "maxReplicas": 1 }
    }
  }
}
