# Copy this file to release.env on the OCI host. Never commit release.env.
# Resolve and verify all image digests before deployment; mutable tags are rejected.
API_IMAGE=REGISTRY/NEIGHBOURHOOD-API@sha256:REPLACE_WITH_64_HEX_DIGEST
WORKER_IMAGE=REGISTRY/NEIGHBOURHOOD-WORKER@sha256:REPLACE_WITH_64_HEX_DIGEST
NODE_IMAGE=node:24-bookworm-slim@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
RELEASE_VERSION=REPLACE_WITH_FULL_LOWERCASE_40_CHARACTER_GIT_SHA

# Public static-shell project names. No secrets belong in this file.
CLOUDFLARE_CUSTOMER_PROJECT=neighbourhood-customer-online-test
CLOUDFLARE_VENDOR_PROJECT=neighbourhood-vendor-online-test
CLOUDFLARE_PARTNER_PROJECT=neighbourhood-partner-online-test
CLOUDFLARE_ADMIN_PROJECT=neighbourhood-admin-online-test

# Private runtime material. Generate each value independently and store it in the host
# secret store. The runtime rejects committed synthetic defaults and these placeholders.
ALLOW_SYNTHETIC_PROVIDERS=synthetic-testing-only
ONLINE_TEST_SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
ONLINE_TEST_DATABASE_URL=REPLACE_WITH_SESSION_POOLER_URL_WITH_SSLMODE_VERIFY_FULL
VALKEY_URL=REPLACE_WITH_RUNTIME_VALKEY_URL
OTP_HASH_KEY=REPLACE_WITH_PRIVATE_RANDOM_MATERIAL_AT_LEAST_32_CHARACTERS
SESSION_TOKEN_HASH_KEY=REPLACE_WITH_DIFFERENT_PRIVATE_RANDOM_MATERIAL_AT_LEAST_32_CHARACTERS
OBJECT_STORAGE_GRANT_KEY=REPLACE_WITH_ANOTHER_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
PAYMENT_WEBHOOK_KEY=REPLACE_WITH_THE_CONFIGURED_PAYMENT_WEBHOOK_SIGNING_KEY
PROVIDER_CLEARING_ACCOUNT_REFERENCE=REPLACE-WITH-CONFIGURED-CLEARING-ACCOUNT
