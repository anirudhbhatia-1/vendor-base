# Copy this file to an uncommitted release.env (mode 600) on the operator's machine.
# Never commit release.env. Private values live in the company password manager and in
# this file only; nothing here is pasted into chat or Git.
#
# Consumed by `node tooling/scripts/deploy-azure-test.mjs --env release.env` (Azure
# Container Apps, D-16) and by `podman compose --env-file release.env` for the laptop
# rehearsal of the same images (infrastructure/online-test/compose.yaml).

# --- Release identity ---------------------------------------------------------------
# Digests come from the `release-images` GitHub Actions run summary. Mutable tags such as
# `latest` are rejected.
API_IMAGE=ghcr.io/anirudhbhatia-1/neighbourhood-api@sha256:REPLACE_WITH_64_HEX_DIGEST
WORKER_IMAGE=ghcr.io/anirudhbhatia-1/neighbourhood-worker@sha256:REPLACE_WITH_64_HEX_DIGEST
CUSTOMER_PWA_IMAGE=ghcr.io/anirudhbhatia-1/neighbourhood-customer-pwa@sha256:REPLACE_WITH_64_HEX_DIGEST
RELEASE_VERSION=REPLACE_WITH_FULL_LOWERCASE_40_CHARACTER_GIT_SHA
LOG_LEVEL=info

# --- Azure Container Apps (public, not secret) --------------------------------------
AZURE_RESOURCE_GROUP=rg-neighbourhood-test
AZURE_CONTAINERAPPS_ENV=cae-neighbourhood-test
ACA_LOCATION=centralindia
# The environment's default domain gives every app its hostname: <app>.<domain>.
API_HOST=api.REPLACE.centralindia.azurecontainerapps.io
SHOP_HOST=shop.REPLACE.centralindia.azurecontainerapps.io
# The Valkey app, reached by app name: TCP ingress inside an environment resolves by name.
VALKEY_HOST=valkey
# 0 lets the API and the shop scale to zero when idle (first request pays a cold start);
# 1 keeps them warm at roughly the cost of the worker.
API_MIN_REPLICAS=0
SHOP_MIN_REPLICAS=0
# Registry pull credentials: a GitHub classic PAT with only `read:packages`, kept in a
# 0600 file. The username is the GitHub account that owns the packages.
GHCR_USERNAME=anirudhbhatia-1
GHCR_READ_TOKEN_FILE=/Users/REPLACE/.config/neighbourhood/ghcr-read-token
# The Supabase CA (public), mounted into the API and worker as a secret volume.
SUPABASE_CA_FILE=/Users/REPLACE/vendor/infrastructure/supabase-production/prod-ca-2021.crt

# The three static shells on Azure Storage static websites, plus the shop. Exact
# origins, comma-separated, no paths. Loopback development origins are always allowed.
CORS_ALLOWED_ORIGINS=https://nbhdvendortest.z29.web.core.windows.net,https://nbhdpartnertest.z29.web.core.windows.net,https://nbhdadmintest.z29.web.core.windows.net,https://shop.REPLACE.centralindia.azurecontainerapps.io

# --- Laptop rehearsal only (compose.yaml; ignored by the Azure deploy) ---------------
CADDY_API_HOST=api.localhost
CADDY_SHOP_HOST=shop.localhost
CADDY_ACME_EMAIL=ops@REPLACE.example
CADDY_ACME_CA=internal

# --- Runtime acknowledgement --------------------------------------------------------
# The fake OTP adapter and the filesystem object store are the only adapters that exist;
# the runtime refuses to start on a shared host without this exact value.
ALLOW_SYNTHETIC_PROVIDERS=synthetic-testing-only

# --- Routing (D-17) -----------------------------------------------------------------
# Real roads on Mapbox: set the provider and inject the token from the environment store.
# Left at `estimate`, every route is a labelled estimate and the runtime says so.
ROUTING_PROVIDER=estimate
# A pk. token: scoped and made to be exposed, so it travels as a plain container
# variable. Leave empty while the provider is `estimate`.
MAPBOX_ACCESS_TOKEN=
ROUTING_PROFILE=driving
ROUTING_TIMEOUT_MS=4000

# --- Supabase (private) -------------------------------------------------------------
# The same project the marketplace is developed against. Runtime uses the transaction
# pooler on 6543 as `marketplace_app.<ref>`; sslmode=verify-full against the mounted CA
# (the runtime substitutes SUPABASE_PRODUCTION_SSL_ROOT_CERT for the URL's sslrootcert).
SUPABASE_PRODUCTION_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_PRODUCTION_RUNTIME_PASSWORD=REPLACE_WITH_THE_MARKETPLACE_APP_ROLE_PASSWORD
SUPABASE_PRODUCTION_DATABASE_URL=postgresql://marketplace_app.abcdefghijklmnopqrst:URL_ENCODED_RUNTIME_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/opt/certs/prod-ca-2021.crt
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_THE_PROJECT_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_THE_PROJECT_SERVICE_ROLE_KEY

# --- Private key material (generate each independently: openssl rand -hex 32) --------
OTP_HASH_KEY=REPLACE_WITH_PRIVATE_RANDOM_MATERIAL_AT_LEAST_32_CHARACTERS
SESSION_TOKEN_HASH_KEY=REPLACE_WITH_DIFFERENT_PRIVATE_RANDOM_MATERIAL_AT_LEAST_32_CHARACTERS
OBJECT_STORAGE_GRANT_KEY=REPLACE_WITH_ANOTHER_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
PAYMENT_WEBHOOK_KEY=REPLACE_WITH_THE_CONFIGURED_PAYMENT_WEBHOOK_SIGNING_KEY
PROVIDER_CLEARING_ACCOUNT_REFERENCE=REPLACE-WITH-CONFIGURED-CLEARING-ACCOUNT
