# Copy this file to release.env on the Azure VM, next to compose.yaml, the Caddyfile and
# prod-ca-2021.crt. Never commit release.env. Values marked private live in the company
# password manager and on the VM only; nothing here is pasted into chat or Git.

# --- Release identity ---------------------------------------------------------------
# Digests come from the `release-images` GitHub Actions run summary. Mutable tags such as
# `latest` are rejected by `pnpm online-test:verify`.
API_IMAGE=ghcr.io/anirudhbhatia-1/neighbourhood-api@sha256:REPLACE_WITH_64_HEX_DIGEST
WORKER_IMAGE=ghcr.io/anirudhbhatia-1/neighbourhood-worker@sha256:REPLACE_WITH_64_HEX_DIGEST
CUSTOMER_PWA_IMAGE=ghcr.io/anirudhbhatia-1/neighbourhood-customer-pwa@sha256:REPLACE_WITH_64_HEX_DIGEST
RELEASE_VERSION=REPLACE_WITH_FULL_LOWERCASE_40_CHARACTER_GIT_SHA
LOG_LEVEL=info

# --- Hostnames (public, not secret) -------------------------------------------------
# The DNS labels of the VM's two public IPs. The API and the customer shell are distinct
# browser origins by design: the BFF's origin check and the API's CORS list are exact.
CADDY_API_HOST=nsapi-REPLACE.centralindia.cloudapp.azure.com
CADDY_SHOP_HOST=nsshop-REPLACE.centralindia.cloudapp.azure.com
CADDY_ACME_EMAIL=ops@REPLACE.example
# Leave empty for Let's Encrypt. Set to `internal` only for a laptop rehearsal.
CADDY_ACME_CA=

# The three static shells on Azure Static Web Apps, plus the customer shell. Exact
# origins, comma-separated, no paths. Loopback development origins are always allowed.
CORS_ALLOWED_ORIGINS=https://neighbourhood-vendor-test.azurestaticapps.net,https://neighbourhood-partner-test.azurestaticapps.net,https://neighbourhood-admin-test.azurestaticapps.net,https://nsshop-REPLACE.centralindia.cloudapp.azure.com

# --- Runtime acknowledgement --------------------------------------------------------
# The fake OTP adapter and the filesystem object store are the only adapters that exist;
# the runtime refuses to start on a shared host without this exact value.
ALLOW_SYNTHETIC_PROVIDERS=synthetic-testing-only

# --- Supabase (private) -------------------------------------------------------------
# The same project the marketplace is developed against. Runtime uses the transaction
# pooler on 6543 as `marketplace_app.<ref>`; sslmode=verify-full against the mounted CA.
SUPABASE_PRODUCTION_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_PRODUCTION_RUNTIME_PASSWORD=REPLACE_WITH_THE_MARKETPLACE_APP_ROLE_PASSWORD
SUPABASE_PRODUCTION_DATABASE_URL=postgresql://marketplace_app.abcdefghijklmnopqrst:URL_ENCODED_RUNTIME_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/opt/certs/prod-ca-2021.crt
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_THE_PROJECT_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_THE_PROJECT_SERVICE_ROLE_KEY

# --- Private key material (generate each independently: openssl rand -hex 32) --------
OTP_HASH_KEY=REPLACE_WITH_PRIVATE_RANDOM_MATERIAL_AT_LEAST_32_CHARACTERS
SESSION_TOKEN_HASH_KEY=REPLACE_WITH_DIFFERENT_PRIVATE_RANDOM_MATERIAL_AT_LEAST_32_CHARACTERS
OBJECT_STORAGE_GRANT_KEY=REPLACE_WITH_ANOTHER_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
PAYMENT_WEBHOOK_KEY=REPLACE_WITH_THE_CONFIGURED_PAYMENT_WEBHOOK_SIGNING_KEY
PROVIDER_CLEARING_ACCOUNT_REFERENCE=REPLACE-WITH-CONFIGURED-CLEARING-ACCOUNT
