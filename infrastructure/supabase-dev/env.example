# Copy this file to .env in the same directory. The .env file is ignored by Git.
# This mode runs the API and worker on your computer while Supabase hosts only
# the synthetic development PostgreSQL/PostGIS database.

APP_ENV=supabase-dev
DATA_MODE=synthetic
LOG_LEVEL=debug
API_HOST=127.0.0.1
API_PORT=3001

# Supabase Dashboard -> Connect -> Session pooler (port 5432), or Direct
# connection when your network supports IPv6. URL-encode the rotated password.
# URLs copied without query parameters are normalized to encrypted development TLS.
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_DATABASE_URL=postgresql://postgres.abcdefghijklmnopqrst:URL_ENCODED_ROTATED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Required only when applying or reverting migrations. Replace the project ref.
SUPABASE_MIGRATION_CONFIRM=apply-abcdefghijklmnopqrst-supabase-dev

# Keep all other providers local/fake in this bounded development mode.
OTP_ADAPTER=fake
OTP_HASH_KEY=replace-with-private-random-material-at-least-32-characters
SESSION_TOKEN_HASH_KEY=replace-with-different-private-random-material-at-least-32-characters
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_LOCAL_PATH=.local-data/objects
OBJECT_STORAGE_GRANT_KEY=replace-with-another-private-random-value-at-least-32-characters

NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# The four PWAs receive only NEXT_PUBLIC_* values (tooling/scripts/run-with-public-env.mjs),
# so the development project's public URL and anon key must be named here. Both come from
# Supabase Dashboard -> Project Settings -> API. Never put the service role key in this file:
# it would reach a browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-development-project-anon-key

# Only local-only fake adapters are implemented (fake one-time passwords, filesystem object
# storage). A non-local environment must acknowledge that explicitly or the API and worker
# refuse to start. Approved MSG91/Razorpay/Supabase Storage adapters remain open D-15 gates.
ALLOW_SYNTHETIC_PROVIDERS=synthetic-testing-only

# Generate independently and keep out of source control. The runtime rejects both the
# committed synthetic defaults and the replace-with placeholders above.
PAYMENT_WEBHOOK_KEY=replace-with-the-configured-payment-webhook-signing-key
PROVIDER_CLEARING_ACCOUNT_REFERENCE=REPLACE-WITH-CONFIGURED-CLEARING-ACCOUNT
