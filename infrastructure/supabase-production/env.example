# Local operator file only. Copy to .env in this directory; never commit it.
# In the deployed API/worker, inject equivalent values from the hosting secret manager.

SUPABASE_PRODUCTION_PROJECT_REF=abcdefghijklmnopqrst

# Use the postgres administrator only for reviewed migrations and role provisioning.
# Download the project CA from Dashboard -> Database Settings -> SSL Configuration.
# Use Direct port 5432 when the runner supports IPv6; otherwise use Session pooler port 5432.
SUPABASE_PRODUCTION_SSL_ROOT_CERT=/absolute/path/to/prod-ca-2021.crt
SUPABASE_PRODUCTION_MIGRATION_URL=postgresql://postgres.abcdefghijklmnopqrst:URL_ENCODED_ADMIN_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/repository/path/infrastructure/supabase-production/secrets/prod-ca-2021.crt
SUPABASE_PRODUCTION_MIGRATION_CONFIRM=apply-abcdefghijklmnopqrst-supabase-production

# Create this independently from the postgres administrator password.
SUPABASE_PRODUCTION_RUNTIME_PASSWORD=REPLACE_WITH_PASSWORD_MANAGER_VALUE_AT_LEAST_32_CHARACTERS
SUPABASE_PRODUCTION_ROLE_CONFIRM=provision-marketplace-app-abcdefghijklmnopqrst

# Runtime URL uses the least-privilege login, never the postgres administrator.
# Transaction mode prevents the API's and worker's short-lived service pools
# from reserving every session-pooler slot. Migrations continue to use 5432.
SUPABASE_PRODUCTION_RUNTIME_CONNECTION_MODE=transaction
SUPABASE_PRODUCTION_DATABASE_URL=postgresql://marketplace_app.abcdefghijklmnopqrst:URL_ENCODED_RUNTIME_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/absolute/repository/path/infrastructure/supabase-production/secrets/prod-ca-2021.crt

# ==============================================================================
# Supabase Auth (email + password sign-in for admin/vendor/partner/customer PWAs)
# Dashboard -> Project Settings -> API
# ==============================================================================
APP_ENV=supabase-production
DATA_MODE=synthetic
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=debug

SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
# The "anon" public key. Safe to ship to the browser.
SUPABASE_ANON_KEY=eyJhbGciOi...REPLACE_WITH_ANON_KEY...
# The "service_role" secret. Server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...REPLACE_WITH_SERVICE_ROLE_KEY...

# Shared with every PWA build so its Supabase client can sign in. Same values
# as SUPABASE_URL / SUPABASE_ANON_KEY above, just under the NEXT_PUBLIC_* names
# Next.js uses to expose them to client-side code. Never expose the service
# role key with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...REPLACE_WITH_ANON_KEY...
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# Customer BFF deployment only: exact external HTTPS origin, no trailing slash.
# Leave unset for `next dev`: localhost:3100 is the canonical local browser host.
# Set this in the customer Worker runtime too, not only during its build.
# CUSTOMER_PWA_ORIGIN=https://your-customer-host.example

OTP_ADAPTER=fake
OTP_HASH_KEY=replace-with-private-random-material-at-least-32-characters
SESSION_TOKEN_HASH_KEY=replace-with-different-private-random-material-at-least-32-characters
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_LOCAL_PATH=.local-data/objects
OBJECT_STORAGE_GRANT_KEY=replace-with-another-private-random-value-at-least-32-characters

# Extra browser origins allowed to call the API, comma separated. The loopback
# PWAs on 3100-3103 are always allowed; a deployed PWA is served from its own
# origin and must be listed here. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=

# Only local-only fake adapters are implemented (fake one-time passwords, filesystem object
# storage). A non-local environment must acknowledge that explicitly or the API and worker
# refuse to start. Approved MSG91/Razorpay/Supabase Storage adapters remain open D-15 gates.
ALLOW_SYNTHETIC_PROVIDERS=synthetic-testing-only

# Generate independently and keep out of source control. The runtime rejects both the
# committed synthetic defaults and the replace-with placeholders above.
PAYMENT_WEBHOOK_KEY=replace-with-the-configured-payment-webhook-signing-key
PROVIDER_CLEARING_ACCOUNT_REFERENCE=REPLACE-WITH-CONFIGURED-CLEARING-ACCOUNT
