{
  "name": "neighbourhood-store-marketplace",
  "version": "0.0.0",
  "private": true,
  "description": "Local company-development workspace for the Neighbourhood Store Marketplace.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:verify": "pnpm build && pnpm verify:entrypoints",
    "build:online-test:pwas": "node tooling/scripts/build-online-test-pwas.mjs",
    "lint": "eslint . && pnpm boundaries:check && pnpm dependencies:check && pnpm ci:verify && pnpm online-test:verify",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify:entrypoints": "node tooling/scripts/verify-client-entry-points.mjs",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:controls": "node tooling/scripts/check-boundaries.mjs --self-test && node tooling/scripts/check-dependency-policy.mjs --self-test && node tooling/scripts/scan-secrets.mjs --self-test && node tooling/scripts/verify-ci-workflow.mjs --self-test && node tooling/scripts/ci-evidence.mjs --self-test && node tooling/scripts/verify-online-test-deployment.mjs --self-test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries:check": "node tooling/scripts/check-boundaries.mjs",
    "ci:verify": "node tooling/scripts/verify-ci-workflow.mjs",
    "db:config": "node database/scripts/compose.mjs config",
    "db:down": "node database/scripts/compose.mjs down",
    "db:migrate": "pnpm --filter @neighbourhood-store/database migration:up",
    "db:migrate:online-test": "pnpm --filter @neighbourhood-store/database migration:online-test:up",
    "db:rebuild": "pnpm --filter @neighbourhood-store/database rebuild",
    "db:reset": "pnpm --filter @neighbourhood-store/database reset",
    "db:rollback": "pnpm --filter @neighbourhood-store/database migration:down",
    "db:seed": "pnpm --filter @neighbourhood-store/database seed",
    "db:status": "pnpm --filter @neighbourhood-store/database migration:status",
    "db:status:online-test": "pnpm --filter @neighbourhood-store/database migration:online-test:status",
    "db:test:down": "node database/scripts/compose.mjs test-down",
    "db:test:up": "node database/scripts/compose.mjs test-up",
    "db:up": "node database/scripts/compose.mjs up",
    "db:verify": "node database/scripts/verify-stack.mjs",
    "db:verify:connected": "pnpm --filter @neighbourhood-store/database verify:lifecycle",
    "local:catalogue-access": "tsx database/scripts/create-local-catalogue-access.ts",
    "local:moderator-access": "tsx database/scripts/create-local-moderator-access.ts",
    "dependencies:check": "node tooling/scripts/check-dependency-policy.mjs",
    "online-test:health": "node tooling/scripts/online-test-health.mjs",
    "online-test:verify": "node tooling/scripts/verify-online-test-deployment.mjs",
    "security:secrets": "node tooling/scripts/scan-secrets.mjs",
    "security:dependencies": "pnpm audit --audit-level high --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:controls && pnpm test:unit && pnpm test:integration && pnpm security:secrets",
    "dev": "pnpm --parallel --filter './apps/*' --if-present run dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
