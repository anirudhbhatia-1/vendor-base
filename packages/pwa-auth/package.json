{
  "name": "@neighbourhood-store/pwa-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Cookie-backed Supabase authentication helpers shared by the role PWAs.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./guard": {
      "types": "./src/guard.tsx",
      "default": "./dist/guard.js"
    },
    "./workspace": {
      "types": "./src/workspace.ts",
      "default": "./dist/workspace.js"
    },
    "./login": {
      "types": "./src/login.tsx",
      "default": "./dist/login.js"
    },
    "./proxy": {
      "types": "./src/proxy.ts",
      "default": "./dist/proxy.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:unit": "node ../../tooling/scripts/ensure-packages-built.mjs && node --import tsx --test src/*.spec.ts"
  },
  "dependencies": {
    "@neighbourhood-store/contracts": "workspace:*",
    "@neighbourhood-store/domain-types": "workspace:*",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.58.0",
    "react": "19.2.3"
  },
  "peerDependencies": {
    "next": "16.3.1"
  },
  "devDependencies": {
    "next": "16.3.1"
  }
}
